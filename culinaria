            <!-- Post 1: Receita Salgada -->
            <article>
                <header>
                    <h3>Lasanha Clássica à Bolonhesa</h3>
                    <p>Publicado em <time datetime="2026-08-20">20 de Agosto de 2026</time> por <strong>Chef Ana</strong></p>
                </header>
                
                <img src="https://via.placeholder.com/600x350" alt="Fatia de lasanha à bolonhesa bem recheada">
                
                <p>Uma receita tradicional de família com molho caseiro encorpado e muito queijo derretido. Ideal para o almoço de domingo!</p>

                <h4>Ingredientes Rápidos:</h4>
                <ul>
                    <li>500g de massa para lasanha</li>
                    <li>600g de carne moída</li>
                    <li>2 molhos de tomate</li>
                    <li>400g de queijo mussarela</li>
                </ul>

                <p><a href="#">Ver receita completa →</a></p>

                <!-- Área de Interação: Likes e Dislikes -->
                <section class="interacao-likes">
                    <button type="button">👍 Curtir (<span>42</span>)</button>
                    <button type="button">👎 Não curtir (<span>3</span>)</button>
                </section>

                <!-- Seção de Comentários -->
                <section class="comentarios">
                    <h4>Comentários (2)</h4>

                    <!-- Lista de Comentários Existentes -->
                    <div class="lista-comentarios">
